{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/agenda-alertas.js": {
      "maxDuration": 30
    },
    "api/agenda-link.js": {
      "maxDuration": 15
    },
    "api/whatsapp.js": {
      "maxDuration": 60
    },
    "api/notify-compras.js": {
      "maxDuration": 30
    },
    "api/cnpj.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/agenda-alertas",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?type=lembretes",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron?type=relatorio",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/cron?type=refeicoes-pendentes",
      "schedule": "0 11 * * 1-6"
    },
    {
      "path": "/api/cron?type=refeicoes-validacao",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/ar/:token", "destination": "/aprovar.html?token=:token" },
    { "source": "/rc/:token", "destination": "/confirmar-restaurante.html?token=:token" },
    { "source": "/vr/:token", "destination": "/validar-entrega.html?token=:token" },
    { "source": "/ag/:token", "destination": "/agendar.html?token=:token" },
    { "source": "/limpar", "destination": "/limpar.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
