{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/webhook-whatsapp.js": {
      "maxDuration": 30
    },
    "api/chamados-setup.js": {
      "maxDuration": 30
    },
    "api/extrair-gps-pdf.js": {
      "maxDuration": 30
    },
    "api/pfd-processar.js": {
      "maxDuration": 300
    },
    "api/ocr-receipt.js": {
      "maxDuration": 60
    },
    "api/ocr-formulario.js": {
      "maxDuration": 60
    },
    "api/ocr-boletim-maquina.js": {
      "maxDuration": 60
    },
    "api/whatsapp.js": {
      "maxDuration": 60,
      "includeFiles": "api/_pdf/assets/**"
    },
    "api/notify-compras.js": {
      "maxDuration": 30
    },
    "api/cnpj.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron?type=lembretes",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron?type=relatorio",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/cron?type=refeicoes-pendentes",
      "schedule": "0 11 * * 1-6"
    },
    {
      "path": "/api/cron?type=boletins-fila",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron?type=boletins-retry",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron?type=dds-abertos",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?type=cotacoes-expiradas",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron?type=os-preventivas",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?type=flow-tokens-limpeza",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron?type=storage-limpeza",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron?type=chamados-7h",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    { "source": "/download", "destination": "/download.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/ar/:token", "destination": "/aprovar.html?token=:token" },
    { "source": "/ag/:token", "destination": "/agendar.html" },
    { "source": "/limpar", "destination": "/limpar.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
